<idea-plugin>
    <id>ai.levelcode.plugin</id>
    <name>LevelCode</name>
    <vendor email="support@levelcode.ai" url="https://levelcode.ai">LevelCode</vendor>

    <description><![CDATA[
        <p>LevelCode — AI coding agent embedded in your IDE.</p>
        <p>Launch the LevelCode CLI from the editor to decompose tasks,
        coordinate multi-agent work, and apply changes across your codebase.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="LevelCode"
                    anchor="right"
                    factoryClass="ai.levelcode.plugin.LevelCodeToolWindowFactory"
                    icon="/icons/levelcode.svg"/>
    </extensions>

    <actions>
        <action id="ai.levelcode.plugin.AskLevelCode"
                class="ai.levelcode.plugin.LevelCodeAction"
                text="Ask LevelCode"
                description="Send a prompt to the LevelCode AI agent"
                icon="/icons/levelcode.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
